# Variables de entorno para Frontend (Vercel / Local)
# En Vercel, coloca aquí la URL HTTPS pública de tu backend en Railway (ej. https://contagestion-api.up.railway.app)
VITE_SUPABASE_URL=http://localhost:3002

# Clave pública del cliente (en producción usa cualquier cadena pública distinta a JWT_SECRET)
VITE_SUPABASE_ANON_KEY=contagestion-clave-publica-cliente

